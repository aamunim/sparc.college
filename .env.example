# কপি করে .env বানান (cp .env.example .env)। .env কখনো Git-এ যাবে না।
# এখানে শুধু পাবলিক মান — EXPO_PUBLIC_ মানে অ্যাপের ভেতরে সবাই দেখতে পারে।
# service_role key, ডেটাবেস পাসওয়ার্ড, Access Token এখানে কখনো নয় (GitHub Secrets-এ)।

# dev | staging | prod
EXPO_PUBLIC_APP_ENV=dev

# Supabase → Project Settings → API (Project URL, anon/publishable key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
