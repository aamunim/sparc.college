{
  "name": "sparc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @sparc/mobile",
    "admin": "npm run dev -w @sparc/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-locales.js",
    "test": "npm test -w @sparc/mobile --",
    "build:web": "npm run export:web -w @sparc/mobile -- --output-dir dist",
    "build:admin": "npm run build -w @sparc/admin",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm test -- --ci",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript > packages/core/src/types/database.ts && prettier --write packages/core/src/types/database.ts --log-level warn",
    "db:lint": "supabase db lint --schema public,private,analytics --level warning --fail-on warning",
    "db:bench": "bash scripts/db-bench.sh"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3"
  }
}
