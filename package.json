    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm test -- --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
